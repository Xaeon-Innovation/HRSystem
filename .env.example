# Root
# Docker Compose default:
# DATABASE_URL=postgresql://hr:hr@localhost:5432/hr_system
# Local Homebrew Postgres (trust auth) default used in this workspace:
DATABASE_URL=postgresql://hr@localhost:5432/hr_system
JWT_SECRET=dev-jwt-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-min-32
# INTEGRATION_SECRETS_KEY=dev-integration-secrets-key-change-in-production-min-32
INTEGRATION_SECRETS_KEY=dev-integration-secrets-key-change-in-production-min-32
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# Seed defaults
SEED_SUPER_ADMIN_EMAIL=superadmin@hr.local
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin123!

# UI redesign demo spine (feature flag)
# NEXT_PUBLIC_UI_REDESIGN=1 enables new shell/tokens for all tenants (or allowlisted ones)
# NEXT_PUBLIC_UI_REDESIGN_TENANTS=uuid1,uuid2  # optional allowlist; empty = all when flag on
# Local override: localStorage.setItem('hr_ui_redesign','1')

# Paymob billing (legacy — unused on live path; kept for old rows)
# PAYMOB_BASE_URL=https://accept.paymob.com
# PAYMOB_API_KEY=
# PAYMOB_SECRET_KEY=
# PAYMOB_PUBLIC_KEY=
# PAYMOB_INTEGRATION_ID=
# PAYMOB_HMAC_SECRET=
# PAYMOB_CURRENCY=USD

# Polar billing (optional in local; required for live checkout)
# POLAR_ACCESS_TOKEN=polar_oat_...
# POLAR_WEBHOOK_SECRET=whsec_...
# POLAR_SERVER=sandbox
# WEB_APP_URL=http://localhost:3000
# API_PUBLIC_URL=http://localhost:4000
# Webhook: {API_PUBLIC_URL}/v1/webhooks/polar

# HubSpot CRM connector (OAuth). Redirect URI must be:
# {API_PUBLIC_URL}/v1/integrations/oauth/callback
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=

# Optional email delivery for in-app notifications (pick one):
# RESEND_API_KEY=
# EMAIL_FROM=Polara <onboarding@resend.dev>
# ELEVORA_SUPPORT_EMAIL=info@xaeons.com
# SMTP_WEBHOOK_URL=

# SSO / OIDC (planned — see docs/SSO.md; not implemented yet)
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=
# OIDC_REDIRECT_URI=
# OIDC_SCOPES=openid email profile
# NEXT_PUBLIC_OIDC_ENABLED=0
# Optional per-provider overrides:
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
# OIDC_MICROSOFT_CLIENT_ID=
# OIDC_MICROSOFT_CLIENT_SECRET=
# OIDC_MICROSOFT_TENANT=common

# UI redesign demo spine
# NEXT_PUBLIC_UI_REDESIGN=1
# NEXT_PUBLIC_UI_REDESIGN_TENANTS=

