# Root
# Docker Compose default:
# DATABASE_URL=postgresql://hr:hr@localhost:5432/hr_system
# Local Homebrew Postgres (trust auth) default used in this workspace:
DATABASE_URL=postgresql://hr@localhost:5432/hr_system
JWT_SECRET=dev-jwt-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-min-32
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# Seed defaults
SEED_SUPER_ADMIN_EMAIL=superadmin@hr.local
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin123!
