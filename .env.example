CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# Seed defaults
SEED_SUPER_ADMIN_EMAIL=superadmin@hr.local
