{
  "name": "hr-system",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @hr/db generate",
    "db:migrate": "pnpm --filter @hr/db migrate",
    "db:seed": "pnpm --filter @hr/db seed",
    "db:studio": "pnpm --filter @hr/db studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
