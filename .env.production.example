# Copy to .env.production and fill in real values before launching:
#   cp .env.production.example .env.production
#
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# --- Postgres (Compose service) ---
POSTGRES_USER=hr
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=hr_system

# --- API secrets (required; use long random strings) ---
JWT_SECRET=change-me-jwt-secret-min-32-chars-xxxxxxxx
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-xxxx

# --- Public URLs (no TLS / direct ports example) ---
# Replace YOUR_HOST with the VM public IP or hostname.
CORS_ORIGIN=http://YOUR_HOST:3000
WEB_APP_URL=http://YOUR_HOST:3000
API_PUBLIC_URL=http://YOUR_HOST:4000
NEXT_PUBLIC_API_URL=http://YOUR_HOST:4000
NEXT_PUBLIC_WS_URL=ws://YOUR_HOST:4000/ws

# Publish ports on the host (omit / firewall when using Caddy TLS only)
WEB_PUBLISH_PORT=3000
API_PUBLISH_PORT=4000

# --- HTTPS via Caddy (docker compose --profile tls) ---
# Point DNS A records for both names at this host, then set:
# WEB_DOMAIN=app.example.com
# API_DOMAIN=api.example.com
# CORS_ORIGIN=https://app.example.com
# WEB_APP_URL=https://app.example.com
# API_PUBLIC_URL=https://api.example.com
# NEXT_PUBLIC_API_URL=https://api.example.com
# NEXT_PUBLIC_WS_URL=wss://api.example.com/ws
# WEB_DOMAIN=app.example.com
# API_DOMAIN=api.example.com

# --- Optional seed (one-off; change before production use) ---
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=change-me-strong-admin-password

# --- Paymob billing (optional until live checkout) ---
# PAYMOB_BASE_URL=https://accept.paymob.com
# PAYMOB_API_KEY=
# PAYMOB_SECRET_KEY=
# PAYMOB_PUBLIC_KEY=
# PAYMOB_INTEGRATION_ID=
# PAYMOB_HMAC_SECRET=
# PAYMOB_CURRENCY=USD
# Webhook to register: {API_PUBLIC_URL}/v1/webhooks/paymob
