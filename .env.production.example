# Shared Verpex VPS (website + CMS already on this server):
#   cp .env.production.example .env.production
#   bash scripts/gen-prod-secrets.sh   # paste into .env.production
#   nano .env.production               # set YOURDOMAIN
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#   # then reverse-proxy app/api subdomains → 127.0.0.1:3000 / :4000
#   # DO NOT use --profile tls (Caddy) while other sites share ports 80/443
#
# Full steps: docs/HOSTING.md

# --- Postgres (Compose only — not published on the host) ---
POSTGRES_USER=hr
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=hr_system

# --- API secrets (required; use scripts/gen-prod-secrets.sh) ---
JWT_SECRET=change-me-jwt-secret-min-32-chars-xxxxxxxx
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-xxxx
INTEGRATION_SECRETS_KEY=change-me-integration-secrets-key-min-32

# --- Public HTTPS hostnames (reverse-proxied by existing Nginx/Apache/cPanel) ---
WEB_DOMAIN=app.YOURDOMAIN
API_DOMAIN=api.YOURDOMAIN

CORS_ORIGIN=https://app.YOURDOMAIN
WEB_APP_URL=https://app.YOURDOMAIN
API_PUBLIC_URL=https://api.YOURDOMAIN
NEXT_PUBLIC_API_URL=https://api.YOURDOMAIN
NEXT_PUBLIC_WS_URL=wss://api.YOURDOMAIN/ws

# Bound to 127.0.0.1 in docker-compose.prod.yml (not public).
# Change if 3000/4000 are already taken on the host; update proxy configs to match.
WEB_PUBLISH_PORT=3000
API_PUBLISH_PORT=4000

# --- Optional seed (one-off) ---
SEED_SUPER_ADMIN_EMAIL=superadmin@YOURDOMAIN
SEED_SUPER_ADMIN_PASSWORD=change-me-strong-admin-password

# --- Paymob billing (optional until live checkout) ---
# PAYMOB_BASE_URL=https://accept.paymob.com
# PAYMOB_API_KEY=
# PAYMOB_SECRET_KEY=
# PAYMOB_PUBLIC_KEY=
# PAYMOB_INTEGRATION_ID=
# PAYMOB_HMAC_SECRET=
# PAYMOB_CURRENCY=USD
# Webhook: https://api.YOURDOMAIN/v1/webhooks/paymob
